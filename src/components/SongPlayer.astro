---
// A compact play button for a SoundCloud track. The SoundCloud widget is
// loaded in a hidden iframe and driven through its JavaScript API, so the
// player matches the site instead of SoundCloud's own styling. If the browser
// won't let the hidden widget play, the regular SoundCloud player is shown.
interface Props {
  title: string;
  // A w.soundcloud.com/player/ embed URL.
  embed: string;
  subtitle?: string;
}

const { title, embed, subtitle } = Astro.props;
---

<div class="player" data-player>
  <div class="player__row">
    <button type="button" class="player__toggle" aria-label={`Play ${title}`} data-title={title}>
      <svg class="player__icon player__icon--play" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M7 4v16l13-8z" />
      </svg>
      <svg class="player__icon player__icon--pause" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6 4h4v16H6zM14 4h4v16h-4z" />
      </svg>
    </button>
    <div class="player__info">
      <p class="player__title">{title}</p>
      {subtitle && <p class="player__subtitle">{subtitle}</p>}
      <div class="player__bar" aria-hidden="true"><div class="player__progress"></div></div>
    </div>
  </div>
  <iframe class="player__widget embed embed--audio" data-src={embed} title={title} allow="autoplay"></iframe>
</div>

<style>
  .player {
    position: relative;
    padding: 1rem;
    background: var(--surface);
    border-radius: 0.75rem;
  }

  .player__row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .player__toggle {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .player__toggle:hover {
    opacity: 0.9;
  }

  .player__toggle:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .player__icon--pause,
  .player.is-playing .player__icon--play {
    display: none;
  }

  .player.is-playing .player__icon--pause {
    display: block;
  }

  .player__info {
    flex: 1;
    min-width: 0;
  }

  .player__title {
    margin: 0;
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .player__subtitle {
    margin: 0.125rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .player__bar {
    margin-top: 0.5rem;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }

  .player__progress {
    width: 0;
    height: 100%;
    background: var(--accent);
  }

  /* Kept in the page (so it can load and play) but out of sight. */
  .player__widget {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .player.is-fallback .player__row {
    display: none;
  }

  .player.is-fallback .player__widget {
    position: static;
    width: 100%;
    height: 166px;
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  type Widget = {
    bind(event: string, cb: (e?: { relativePosition: number }) => void): void;
    play(): void;
    pause(): void;
  };
  type SC = { Widget: ((el: HTMLIFrameElement) => Widget) & { Events: Record<string, string> } };

  let api: Promise<SC> | undefined;
  function loadApi(): Promise<SC> {
    api ??= new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://w.soundcloud.com/player/api.js';
      s.onload = () => resolve((window as unknown as { SC: SC }).SC);
      s.onerror = reject;
      document.head.append(s);
    });
    return api;
  }

  const players: { pause(): void }[] = [];

  document.querySelectorAll<HTMLElement>('[data-player]').forEach((el) => {
    const button = el.querySelector<HTMLButtonElement>('.player__toggle')!;
    const progress = el.querySelector<HTMLElement>('.player__progress')!;
    const iframe = el.querySelector<HTMLIFrameElement>('.player__widget')!;
    const title = button.dataset.title;
    let widget: Widget | undefined;
    let playing = false;

    const showFallback = () => {
      if (!iframe.getAttribute('src')) iframe.src = iframe.dataset.src ?? '';
      el.classList.add('is-fallback');
    };
    const setPlaying = (value: boolean) => {
      playing = value;
      el.classList.toggle('is-playing', value);
      button.setAttribute('aria-label', `${value ? 'Pause' : 'Play'} ${title}`);
    };

    const self = { pause: () => widget?.pause() };
    players.push(self);

    // The widget is loaded on the first press, so its events are bound before
    // it finishes loading and none are missed.
    async function start() {
      const SC = await loadApi();
      iframe.src = iframe.dataset.src ?? '';
      const w = SC.Widget(iframe);
      w.bind(SC.Widget.Events.READY, () => w.play());
      w.bind(SC.Widget.Events.PLAY, () => {
        players.forEach((p) => p !== self && p.pause());
        setPlaying(true);
      });
      w.bind(SC.Widget.Events.PAUSE, () => setPlaying(false));
      w.bind(SC.Widget.Events.FINISH, () => {
        setPlaying(false);
        progress.style.width = '0';
      });
      w.bind(SC.Widget.Events.PLAY_PROGRESS, (e) => {
        progress.style.width = `${(e?.relativePosition ?? 0) * 100}%`;
      });
      widget = w;
    }

    button.addEventListener('click', async () => {
      if (widget) {
        if (playing) widget.pause();
        else widget.play();
        return;
      }
      // Some browsers block audio started from outside the widget; if it
      // hasn't started shortly, show SoundCloud's own player instead.
      setTimeout(() => {
        if (!playing) showFallback();
      }, 6000);
      try {
        await start();
      } catch {
        showFallback();
      }
    });
  });
</script>
