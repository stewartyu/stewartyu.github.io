---
import type { CollectionEntry } from 'astro:content';
import AwardBadges from './AwardBadges.astro';

interface Props {
  show: CollectionEntry<'shows'>;
}

const { show } = Astro.props;
const { title, meta, status, image, awards } = show.data;
---

<a class="card" href={`/shows/${show.id}/`}>
  <div class="card__media">
    {image ? <img src={image} alt="" loading="lazy" /> : <div class="card__placeholder">{title}</div>}
    <AwardBadges awards={awards} class="card__badges" />
  </div>
  <div>
    <h3 class="card__title">{title}</h3>
    <p class="card__meta">{meta ?? status}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
  }

  .card__media {
    position: relative;
  }

  .card img,
  .card__placeholder {
    aspect-ratio: 1 / 1;
    width: 100%;
    object-fit: cover;
    border-radius: 0.5rem;
    transition: transform 0.15s ease;
  }

  .card:hover img {
    transform: translateY(-2px);
  }

  .card__placeholder {
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    font-weight: 900;
    font-size: 1.5rem;
    color: var(--muted);
    background: var(--surface);
  }

  .card__media :global(.card__badges) {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
  }

  .card__title {
    margin: 0;
    font-size: 1.1875rem;
  }

  .card__meta {
    margin: 0.25rem 0 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
