---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AwardBadges from '../../components/AwardBadges.astro';
import SongPlayer from '../../components/SongPlayer.astro';

export async function getStaticPaths() {
  const shows = await getCollection('shows');
  return shows.map((show) => ({ params: { slug: show.id }, props: { show } }));
}

const { show } = Astro.props;
const { title, logline, credit, status, image, website, songs, history, team, quotes, awards } = show.data;
const { Content } = await render(show);

const isVideo = (url: string) => /youtube\.com|youtu\.be|vimeo\.com/.test(url);
const isSoundCloud = (url: string) => url.includes('soundcloud.com');
---

<Base title={title} description={logline}>
  <article>
    <section class="section">
      <div class="container show-head">
        <div class="show-head__text">
          <p class="eyebrow">{credit}</p>
          <h1>{title}</h1>
          <p class="lede">{logline}</p>
          <AwardBadges awards={awards} />
          <p class="status">{status}</p>
        </div>
        {image && <img class="poster" src={image} alt="" />}
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="prose">
          <h2>Synopsis</h2>
          <Content />
        </div>
      </div>
    </section>

    {
      songs.length > 0 && (
        <section class="section">
          <div class="container">
            <h2>Listen</h2>
            <div class="songs">
              {songs.map((song) => (
                <div class="song">
                  {song.embed && isSoundCloud(song.embed) ? (
                    <SongPlayer title={song.title} subtitle={song.description} embed={song.embed} />
                  ) : (
                    <>
                      <h3>{song.title}</h3>
                      {song.description && <p>{song.description}</p>}
                      {song.embed && (
                        <iframe
                          class:list={['embed', isVideo(song.embed) ? 'embed--video' : 'embed--audio']}
                          src={song.embed}
                          title={song.title}
                          loading="lazy"
                          allow="autoplay; encrypted-media; picture-in-picture"
                          allowfullscreen
                        />
                      )}
                    </>
                  )}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      quotes.length > 0 && (
        <section class="section">
          <div class="container">
            <div class="quotes">
              {quotes.map((q) => (
                <blockquote>
                  <p>“{q.text}”</p>
                  <cite>{q.source}</cite>
                </blockquote>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      (history.length > 0 || team.length > 0) && (
        <section class="section">
          <div class="container details">
            {history.length > 0 && (
              <div>
                <h2>Development history</h2>
                <dl>
                  {history.map((h) => (
                    <>
                      <dt>{h.year}</dt>
                      <dd>{h.event}</dd>
                    </>
                  ))}
                </dl>
              </div>
            )}
            {team.length > 0 && (
              <div>
                <h2>Creative team</h2>
                <dl>
                  {team.map((t) => (
                    <>
                      <dt>{t.role}</dt>
                      <dd>{t.name}</dd>
                    </>
                  ))}
                </dl>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      website && (
        <section class="section">
          <div class="container">
            <p class="website"><a class="button" href={website}>Visit the show's website</a></p>
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  .show-head {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    align-items: center;
  }

  .show-head__text {
    flex: 1 1 26rem;
    min-width: 0;
  }

  .show-head h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }

  .status {
    margin: 1.25rem 0 0;
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--soft);
  }

  .website {
    margin: 0;
    text-align: center;
  }

  .poster {
    flex: 1 1 26rem;
    min-width: 0;
    width: 100%;
    border-radius: 1rem;
  }

  .songs {
    display: grid;
    gap: 1.5rem;
    max-width: 48rem;
  }

  .song h3 {
    margin-bottom: 0.25rem;
  }

  .song p {
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 2.5rem;
  }

  blockquote {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  blockquote p {
    margin: 0 0 0.75rem;
  }

  cite {
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .details {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48rem) {
    .details {
      grid-template-columns: 1fr 1fr;
    }
  }

  .details h2 {
    font-size: 1.5rem;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.75rem 1.5rem;
    margin: 0;
  }

  dt {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--muted);
    padding-top: 0.15rem;
  }

  dd {
    margin: 0;
    color: var(--soft);
  }
</style>
