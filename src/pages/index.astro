---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ShowCard from '../components/ShowCard.astro';
import headshot from '../assets/headshot.jpg';

const featured = (await getCollection('shows', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <section class="section">
    <div class="container hero">
      <div>
        <p class="eyebrow">Composer · Lyricist</p>
        <h1>Hi, I'm Stewart!</h1>
        <p class="lede">I’m a New York-based composer and lyricist. Currently developing <a href="/shows/yellow-frosted-willow/">a new musical</a> about the life and career of Anna May Wong.</p>
        <p><a class="button" href="/shows/">See the shows</a></p>
      </div>
      <Image src={headshot} alt="Stewart Yu" class="hero__photo" width={480} loading="eager" />
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="container">
          <h2>Featured shows</h2>
          <div class="grid">
            {featured.map((show) => (
              <ShowCard show={show} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 3fr 2fr;
    }
  }

  .hero__photo {
    border-radius: 0.75rem;
    max-width: 22rem;
    width: 100%;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
  }
</style>
