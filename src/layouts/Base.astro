---
import '../styles/global.css';
import { SITE, NAV, SOCIALS } from '../consts';
import EmailLink from '../components/EmailLink.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${SITE.name} — ${SITE.tagline}.` } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__name" href="/">{SITE.name}</a>
        <nav>
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© {new Date().getFullYear()} {SITE.name}</p>
        <p>
          {SOCIALS.map((s) => <a href={s.href}>{s.label}</a>)}
          <EmailLink>Email</EmailLink>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .site-header__name {
    font-weight: 900;
    font-stretch: 125%;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  nav a {
    font-family: var(--mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.75rem 0;
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 2rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    /* A rule across the content width only, not the side padding. */
    background: linear-gradient(var(--border), var(--border)) top / calc(100% - 3rem) 1px no-repeat;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .site-footer p {
    margin: 0.25rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .site-footer :global(a) {
    color: var(--muted);
  }

  .site-footer :global(a:hover) {
    color: var(--accent);
  }
</style>
